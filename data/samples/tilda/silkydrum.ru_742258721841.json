: "[{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor6561-6561-4737-b465-326332303963\\/74226156.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor3665-6132-4333-b831-373762633231\\/17809276.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor3438-3135-4635-a232-396466633436\\/64420358.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor3636-6136-4030-b037-656665646261\\/70144217.png\"}]", "buttonlink": "https://www.silkydrum.ru/catalog/silky-5-years-t-shirt", "buttontarget": "", "json_options": "[{\"title\":\"размер\",\"params\":{\"view\":\"select\",\"hasColor\":false,\"linkImage\":false},\"values\":[\"S\",\"M\",\"L\"]}]", "sort": 1003992, "url": "https://www.silkydrum.ru/catalog/silky-5-years-t-shirt", "pack_label": "lwh", "pack_x": 0, "pack_y": 0, "pack_z": 0, "pack_m": 0, "partuids": "[742258721841]", "externalid": "11SJRSSUZJ2RXfaahr31", "editions": [{"uid": 371852182502, "externalid": "ECBdYk8vE8EtvnbpRxNu", "sku": "", "price": "2 555.00", "priceold": "", "quantity": "2", "img": "", "размер": "S"}, {"uid": 114115151952, "externalid": "hNsrARb7EvDVdOgeoxPn", "sku": "", "price": "2 555.00", "priceold": "", "quantity": "0", "img": "", "размер": "M"}, {"uid": 626176442512, "externalid": "O6p0xy7ytCsTTUgMI6fi", "sku": "", "price": "2 555.00", "priceold": "", "quantity": "0", "img": "", "размер": "L"}], "characteristics": []}, {"uid": 397210980502, "title": "Футболка Silky Dream", "sku": "", "text": "Нас часто ищут в кофейнях так: «А у вас есть Silky Dream?». Чтобы раз и навсегда закрыть вопрос, Руслан Шульга взял ручку и листок, перечеркнул и написал — Drum. Мы отсканировали, сделали вышивку. И теперь это наша футболка.<br /><br />Хорошо держит форму, из плотного дышащего хлопка, свободного оверсайз-кроя. Не футболка — мечта. Делали ее небольшим тиражом, поэтому количество ограничено.<br /><br />Размер: M<br />Материал: 100% хлопок<br />Рекомендации: стирать при температуре воды 30°С", "mark": "", "quantity": "", "portion": 0, "unit": "", "single": "", "price": "3200.0000", "priceold": "", "descr": "Нас часто ищут в кофейнях так: «А у вас есть Silky Dream?». Чтобы раз и навсегда закрыть вопрос, Руслан Шульга взял ручку и листок, перечеркнул и написал — Drum. Мы отсканировали, сделали вышивку. И теперь это наша футболка.<br /><br />Хорошо держит форму, из плотного дышащего хлопка, свободного оверсайз-кроя. Не футболка — мечта. Делали ее небольшим тиражом, поэтому количество ограничено.", "gallery": "[{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor6231-3937-4837-b564-663238306664\\/988615ed744aeefcbde68cf8dcf9d223.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor3863-6333-4961-b334-376339393731\\/39a07b7eff475b0d520d6371a8e06dfd.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor6638-6636-4565-b232-653761316439\\/49c10a7d515ae02e9223b8e234a7d1be.jpg\"}]", "buttonlink": "https://www.silkydrum.ru/catalog/silky-dream-t-shirt", "buttontarget": "", "json_options": "[{\"title\":\"цвет\",\"params\":{\"view\":\"select\",\"hasColor\":true,\"linkImage\":true},\"values\":[\"M (черная)\",\"M (зеленая)\",\"M (серая)\"]}]", "sort": 1003988, "url": "https://www.silkydrum.ru/catalog/silky-dream-t-shirt", "pack_label": "lwh", "pack_x": 0, "pack_y": 0, "pack_z": 0, "pack_m": 0, "partuids": "[742258721841]", "externalid": "2iXZiAVzNR2uc7GsyBYZ", "editions": [{"uid": 839591122342, "externalid": "GvhjaE0Tk0ZSXTiEUspM", "sku": "", "price": "3 200.00", "priceold": "", "quantity": "3", "img": "https://static.tildacdn.com/stor6231-3937-4837-b564-663238306664/988615ed744aeefcbde68cf8dcf9d223.jpg", "цвет": "M (черная)"}, {"uid": 162914909212, "externalid": "v05Tmsj1sieDo698Csu5", "sku": "", "price": "3 200.00", "priceold": "", "quantity": "5", "img": "https://static.tildacdn.com/stor3863-6333-4961-b334-376339393731/39a07b7eff475b0d520d6371a8e06dfd.jpg", "цвет": "M (зеленая)"}, {"uid": 219378022372, "externalid": "muTdNcKcUh65C8BEBUfT", "sku": "", "price": "3 200.00", "priceold": "", "quantity": "6", "img": "https://static.tildacdn.com/stor6638-6636-4565-b232-653761316439/49c10a7d515ae02e9223b8e234a7d1be.jpg", "цвет": "M (серая)"}], "characteristics": []}, {"uid": 883124488522, "title": "Каппинговая ложка Silky Drum", "sku": "", "text": "Каппинговую ложку Silky Drum легко узнать: на ручке гравировка, а в чаше — наша птичка. Это профессиональная модель от тайваньского бренда «Акиракоки»: его кофейные аксессуары часто мелькают на Мировых чемпионатах бариста.<br /><br />У ложки идеальная геометрия: округлая чаша и тонкий край. Получится резким глотком распылить кофе по всей ротовой полости. Так рецепторы одновременно чувствуют кислотность, сладость и текстуру.<br /><br />В комплекте тканевый мешочек. Ложка всегда будет с вами: на фестивалях, чемпионатах или даже в гостях у друзей.<br /><br /><strong>Три варианта ложки:</strong><br /><ul><li data-list=\"bullet\">Золото и розовое золото — это нержавеющая сталь с напылением.</li><li data-list=\"bullet\">Черная ложка — из титана. Ей удобно снимать «шапку» кофе на каппинге.</li></ul>", "mark": "", "quantity": "", "portion": 0, "unit": "", "single": "", "price": "2900.0000", "priceold": "", "descr": "На&nbsp;ручке&nbsp;— гравировка, в&nbsp;чаше&nbsp;— птичка на&nbsp;удачу. Золотая и&nbsp;розовая ложки равномерно распределяют кофе при глотке. А&nbsp;черная титановая модель с&nbsp;удлиненной чашей помогает ловко снять кофейную «шапку». В&nbsp;комплекте тканевый мешочек, чтобы ложка всегда была под рукой: на&nbsp;фестивалях, чемпионатах и&nbsp;в&nbsp;кофейнях.", "gallery": "[{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor3834-6263-4238-a338-396432373961\\/c6e38c8517ccea303528e2ef9efe926a.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor6433-6261-4165-a631-323331336233\\/145d7f203b6e1209884f8b28ccbc6f46.jpg\"},{\"img\":\"https:\\/\\/static.tildacdn.com\\/stor3135-3065-4138-b462-353266373764\\/d3efa6b87473fc94a57312bf9f4f6ed8.jpg\"}]", "buttonlink": "https://www.silkydrum.ru/catalog/silky-drum-cupping-spoon", "buttontarget": "", "json_options"